<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_nord_sync_mrp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nord.sync.mrp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nord_sync.res_config_settings_view_form_nord_sync"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='nord_sync_settings_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                    <div class="o_setting_left_pane">
                        <field name="nord_sync_confirm_workcenter_on_start"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="nord_sync_confirm_workcenter_on_start"
                               string="Confirm Work Center on Start"/>
                        <div class="text-muted">
                            Interrupts a human-clicked Start on a workorder with a wizard
                            showing the work center already assigned, so it can be
                            confirmed or changed before work actually begins. Off by
                            default: Start begins work immediately.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                    <div class="o_setting_right_pane">
                        <label for="nord_sync_default_workcenter_control_mode"
                               string="Default Work Center Control Mode"/>
                        <div class="text-muted">
                            Applied to a new work center's floor-event fields only when
                            nothing about Control Mode is set at creation time. Left empty
                            (default): a new work center keeps behaving as Odoo-controlled,
                            unchanged. Never revisited once a work center exists, so
                            changing this later never touches one already created.
                        </div>
                        <field name="nord_sync_default_workcenter_control_mode"/>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                    <div class="o_setting_right_pane">
                        <label for="nord_sync_mo_change_behavior"
                               string="Work Center MO Change Behavior"/>
                        <div class="text-muted">
                            Determines whether to close the previous MO's timesheet or keep it running when changing the current MO on a work center.
                        </div>
                        <field name="nord_sync_mo_change_behavior"/>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                    <div class="o_setting_left_pane">
                        <field name="nord_sync_prevent_mo_change_if_running"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="nord_sync_prevent_mo_change_if_running"
                               string="Block MO Change If Running"/>
                        <div class="text-muted">
                            Prevents changing the MO on a work center if there is a work order in progress, requiring a stop first.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                    <div class="o_setting_right_pane">
                        <label for="nord_sync_unassigned_work_behavior"
                               string="Machine Working Without MO"/>
                        <div class="text-muted">
                            When a machine reports work but the work center has no MO assigned: start the first scheduled MO or create unassigned timesheets to be attributed later.
                        </div>
                        <field name="nord_sync_unassigned_work_behavior"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
