<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nord_sync_close_request_list" model="ir.ui.view">
        <field name="name">nord_sync.close.request.list</field>
        <field name="model">nord_sync.close.request</field>
        <field name="arch" type="xml">
            <list string="nordCount Requests" create="0" edit="0"
                  decoration-success="outcome == 'closed'"
                  decoration-warning="outcome in ('refused', 'not_found', 'no_codes')"
                  decoration-danger="outcome in ('invalid_token', 'error')">
                <field name="create_date"/>
                <field name="code"/>
                <field name="production_id"/>
                <field name="outcome" widget="badge"/>
                <field name="http_status"/>
                <field name="message" string="Message / what was received"/>
                <field name="remote_ip" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_nord_sync_close_request_search" model="ir.ui.view">
        <field name="name">nord_sync.close.request.search</field>
        <field name="model">nord_sync.close.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="production_id"/>
                <filter name="closed" string="Closed" domain="[('outcome', '=', 'closed')]"/>
                <filter name="failed" string="Not closed" domain="[('outcome', '!=', 'closed')]"/>
                <filter name="today" string="Today" domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="by_outcome" string="Result" context="{'group_by': 'outcome'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nord_sync_close_request" model="ir.actions.act_window">
        <field name="name">nordCount Requests</field>
        <field name="res_model">nord_sync.close.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No close-MO request yet</p>
            <p>Every call nordCount makes to the close-MO link shows up here, closed or not.</p>
        </field>
    </record>

    <menuitem id="menu_nord_sync_close_request"
              name="nordCount Requests"
              action="action_nord_sync_close_request"
              parent="mrp.menu_mrp_reporting"
              groups="mrp.group_mrp_manager"
              sequence="95"/>
</odoo>
