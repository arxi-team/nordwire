<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Nord Sync Resource Mapping (ADR 0026) — reuses the native Resources
         screen (Settings > Technical > Resource > Resources) instead of a
         custom view: resource.resource already covers mrp.workcenter and
         hr.employee alike via their shared resource_id. -->
    <record id="resource_resource_tree_nord_sync" model="ir.ui.view">
        <field name="name">resource.resource.list.nord.sync</field>
        <field name="model">resource.resource</field>
        <field name="inherit_id" ref="resource.resource_resource_tree"/>
        <field name="arch" type="xml">
            <field name="resource_type" position="after">
                <field name="nord_sync_resource_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="resource_resource_form_nord_sync" model="ir.ui.view">
        <field name="name">resource.resource.form.nord.sync</field>
        <field name="model">resource.resource</field>
        <field name="inherit_id" ref="resource.resource_resource_form"/>
        <field name="arch" type="xml">
            <field name="resource_type" position="after">
                <field name="nord_sync_resource_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
