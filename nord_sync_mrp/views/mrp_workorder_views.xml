<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone "change work center" button, visible once a workorder
         is already 'progress': Start's own button is gone by then, and
         workcenter_id is read-only in the base list at that point
         (readonly="state in ['cancel', 'done', 'progress']" on the field
         itself), so this wizard-based action is the only way to correct it
         without touching the base views' own readonly logic. -->
    <record id="mrp_production_workorder_tree_editable_view_nord_sync" model="ir.ui.view">
        <field name="name">mrp.production.work.order.list.editable.nord.sync</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <!-- Start gives way once the operation is running, whoever's line it is -->
            <xpath expr="//button[@name='button_start']" position="attributes">
                <attribute name="invisible">production_state in ('draft', 'done', 'cancel') or working_state == 'blocked' or state in ('done', 'cancel') or is_user_working or nord_sync_running</attribute>
            </xpath>
            <button name="button_finish" position="after">
                <field name="nord_sync_in_setup" column_invisible="True"/>
                <field name="nord_sync_running" column_invisible="True"/>
                <button name="action_nord_sync_stop" type="object"
                        title="Stop" class="btn-warning px-2" icon="fa-stop"
                        invisible="not nord_sync_running or is_user_working or state in ('done', 'cancel')"/>
                <button name="action_nord_sync_start_production" type="object"
                        title="Start production (ends the open reason)" class="btn-success px-2" icon="fa-play"
                        invisible="not nord_sync_in_setup or state in ('done', 'cancel')"/>
                <button name="action_nord_sync_change_workcenter" type="object"
                        title="Change Work Center" class="btn-light px-2" icon="fa-exchange"
                        invisible="state != 'progress'"/>
            </button>
        </field>
    </record>

    <!-- Nordwire's own electric_consume(_cost) (B9, Result Push work_sessions)
         had no view anywhere: correctly populated in the DB, invisible in
         the UI. electric_consume on the per-session line (Time Tracking tab)
         is what the Core actually sent per nord.timesheet; electric_consume_cost
         on the workorder itself is the aggregate times this company's tariff. -->
    <record id="mrp_production_workorder_form_view_nord_sync" model="ir.ui.view">
        <field name="name">mrp.production.work.order.form.nord.sync</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="nord_sync_in_setup" invisible="1"/>
                <button name="action_nord_sync_start_production" type="object" string="Start production"
                        class="btn-success" icon="fa-play"
                        invisible="not nord_sync_in_setup or state in ('done', 'cancel')"/>
            </xpath>
            <field name="production_id" position="after">
                <field name="electric_consume" string="Electric Consume (kWh)"/>
                <field name="electric_consume_cost" string="Electric Consume Cost"/>
            </field>
            <!-- time_ids' own nested list+form both have a loss_id field:
                 explicit xpath, scoped to the list only, so this doesn't hit
                 the ambiguous-match error a bare <field name="loss_id"> would. -->
            <xpath expr="//field[@name='time_ids']/list//field[@name='loss_id']" position="after">
                <field name="electric_consume" string="Electric (kWh)" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
