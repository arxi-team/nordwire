<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Work center list: the MO each one is working on now -->
    <record id="mrp_workcenter_tree_view_nord_sync" model="ir.ui.view">
        <field name="name">mrp.workcenter.list.nord_sync</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="nord_sync_current_production_id" string="MO Atual" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_workcenter_view_nord_sync" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.nord.sync</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <!-- The reference rate of the machine overview's Performance -->
            <xpath expr="//group[@name='capacity']/div[field[@name='oee_target']]" position="after">
                <label for="nord_sync_capacity_per_hour"/>
                <div class="o_row">
                    <field name="nord_sync_capacity_per_hour"/> units / hour
                </div>
            </xpath>
            <!-- Work center actions, in the form header -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_nord_sync_emit_alert" type="object" string="Emit alert"
                            icon="fa-exclamation-triangle" class="btn-warning"/>
                    <button name="action_nord_sync_clear_alerts" type="object" string="Clear alerts"
                            icon="fa-check" class="btn-secondary"/>
                </header>
            </xpath>
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Nordwire" name="nord_sync">
                    <div class="mb-2">
                        <button name="action_nord_sync_force_resync_reasons" type="object"
                                string="Resync Reasons to Core" class="btn-secondary"
                                groups="base.group_system"
                                help="Re-sends every session-loss reason and reason type to the Core, even ones already imported there — not specific to this work center, use after the Core's own copy was lost."/>
                    </div>
                    <group>
                        <label for="nord_sync_current_production_id"/>
                        <div class="o_row">
                            <field name="nord_sync_current_production_id" readonly="1"/>
                            <button name="action_nord_sync_start" type="object" string="Start" icon="fa-play"
                                    class="btn-link" invisible="not nord_sync_current_production_id or nord_sync_mo_running"/>
                            <field name="nord_sync_mo_running" invisible="1"/>
                            <button name="action_nord_sync_stop" type="object" string="Stop" icon="fa-stop"
                                    class="btn-link" invisible="not nord_sync_current_production_id"/>
                        </div>
                        <field name="nord_sync_resource_id" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="nord_sync_resource_id">
                        Not mapped to a Nord Core resource yet — nothing below is sent to the Core
                        until this is set.
                    </div>
                    <separator string="Control Mode"/>
                    <group>
                        <field name="nord_sync_control_mode"/>
                    </group>
                    <separator string="MO &amp; Work Order Rules"/>
                    <group>
                        <group>
                            <field name="nord_sync_mo_change_behavior" readonly="nord_sync_control_mode == 'nord'"/>
                            <field name="nord_sync_prevent_mo_change_if_running" readonly="nord_sync_control_mode == 'nord'"
                                   invisible="nord_sync_mo_parallel"/>
                            <field name="nord_sync_mo_parallel" invisible="1"/>
                            <field name="nord_sync_auto_start_on_mo_select"/>
                            <field name="nord_sync_auto_reason_id" options="{'no_quick_create': True}"
                                   context="{'default_manual': True}"/>
                        </group>
                        <group>
                            <field name="nord_sync_stop_others_on_start"/>
                            <field name="nord_sync_clear_mo_on_stop"/>
                            <field name="nord_sync_unassigned_work_behavior"/>
                        </group>
                    </group>
                    <group>
                        <group string="Port &amp; Sensor Behavior">
                            <field name="nord_sync_autonomous_close"/>
                            <field name="nord_sync_contention_policy"/>
                        </group>
                        <group string="General Sync Behavior">
                            <field name="nord_sync_granular_push"/>
                            <field name="nord_sync_chain_close"/>
                            <field name="nord_sync_mirror_mode"/>
                            <field name="nord_sync_stop_tracking"/>
                        </group>
                    </group>
                    <separator string="Result Handling"/>
                    <group>
                        <field name="nord_sync_close_notify_only"/>
                    </group>
                    <separator string="Automatic OEE Segments"/>
                    <group>
                        <field name="nord_sync_auto_idle_segments"/>
                    </group>
                    <!-- Today of the machine, after the Kioda machine screen: OEE,
                         working hours, alerts, declarations and OEE per hour -->
                    <separator string="Machine Overview"/>
                    <group>
                        <label for="nord_sync_capacity_fallback"/>
                        <div class="o_row">
                            <field name="nord_sync_capacity_fallback"/> units / hour
                            <span class="text-muted">used for Performance when Capacity per Hour is empty</span>
                        </div>
                    </group>
                    <field name="nord_sync_machine_overview" class="w-100" widget="nord_sync_machine_overview" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Productive / stop / setup time, from the work center's time lines
         (the Core's sessions as logged on its work orders) -->
    <record id="mrp_workcenter_productivity_view_search_nord_sync" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.search.nord.sync</field>
        <field name="model">mrp.workcenter.productivity</field>
        <field name="inherit_id" ref="mrp.oee_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_date_start']" position="before">
                <filter name="nord_productive" string="Productive" domain="[('nord_sync_time_category', '=', 'productive')]"/>
                <filter name="nord_stop" string="Stop" domain="[('nord_sync_time_category', '=', 'stop')]"/>
                <filter name="nord_setup" string="Setup" domain="[('nord_sync_time_category', '=', 'setup')]"/>
                <separator/>
                <filter name="nord_today" string="Today"
                        domain="[('date_start', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='loss_group']" position="after">
                <filter string="Time Category" name="nord_category_group" context="{'group_by': 'nord_sync_time_category'}"/>
                <filter string="Production Order" name="nord_production_group" context="{'group_by': 'production_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_workcenter_productivity_view_graph_nord_sync" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.graph.nord.sync</field>
        <field name="model">mrp.workcenter.productivity</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <graph string="Nord Times" type="bar" stacked="1" sample="1">
                <field name="workcenter_id"/>
                <field name="nord_sync_time_category"/>
                <field name="nord_sync_elapsed_minutes" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="mrp_workcenter_productivity_view_pivot_nord_sync" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.pivot.nord.sync</field>
        <field name="model">mrp.workcenter.productivity</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Nord Times" sample="1">
                <field name="production_id" type="row"/>
                <field name="nord_sync_time_category" type="col"/>
                <field name="nord_sync_elapsed_minutes" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="mrp_workcenter_productivity_view_list_nord_sync" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.list.nord.sync</field>
        <field name="model">mrp.workcenter.productivity</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Nord Times" decoration-success="nord_sync_time_category == 'productive'"
                  decoration-danger="nord_sync_time_category == 'stop'"
                  decoration-warning="nord_sync_time_category == 'setup'">
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="workcenter_id"/>
                <field name="production_id"/>
                <field name="nord_sync_time_category"/>
                <field name="loss_id"/>
                <field name="description" optional="hide"/>
                <field name="nord_sync_elapsed_minutes" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_mrp_workcenter_productivity_nord_sync" model="ir.actions.act_window">
        <field name="name">Nord Times</field>
        <field name="res_model">mrp.workcenter.productivity</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('mrp_workcenter_productivity_view_graph_nord_sync')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('mrp_workcenter_productivity_view_pivot_nord_sync')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mrp_workcenter_productivity_view_list_nord_sync')})]"/>
        <field name="context">{'create': False, 'edit': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No productive, stop or setup time logged yet</p>
        </field>
    </record>

    <!-- Downtime reasons: add, rename and remove them (the ones the
         "Auto Reason on MO Change" of a work center and the stops pick from) -->
    <!-- The category is the loss.type record itself (loss_id): the base list edits
         the related loss_type, which writes onto the shared category record and,
         on a new reason with no category yet, saves nothing -->
    <record id="view_nord_sync_downtime_reason_list" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.loss.list.nord.sync</field>
        <field name="model">mrp.workcenter.productivity.loss</field>
        <field name="arch" type="xml">
            <list string="Downtime Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="loss_id" string="Category" required="1" options="{'no_create': True, 'no_open': True}"/>
            </list>
        </field>
    </record>

    <record id="view_nord_sync_downtime_reason_form" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.loss.form.nord.sync</field>
        <field name="model">mrp.workcenter.productivity.loss</field>
        <field name="arch" type="xml">
            <form string="Downtime Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="loss_id" string="Category" required="1" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nord_sync_downtime_reasons" model="ir.actions.act_window">
        <field name="name">Downtime Reasons</field>
        <field name="res_model">mrp.workcenter.productivity.loss</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('loss_type', '!=', 'productive')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('nord_sync_mrp.view_nord_sync_downtime_reason_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('nord_sync_mrp.view_nord_sync_downtime_reason_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a downtime reason</p>
            <p>Reasons a work center can stop or be in setup for. A reason already used by a
               timesheet cannot be deleted.</p>
        </field>
    </record>

    <menuitem id="menu_nord_sync_downtime_reasons"
              name="Downtime Reasons"
              action="action_nord_sync_downtime_reasons"
              parent="mrp.menu_mrp_configuration"
              groups="mrp.group_mrp_manager"
              sequence="91"/>


    <record id="view_nord_sync_alert_wizard_form" model="ir.ui.view">
        <field name="name">nord_sync.alert.wizard.form</field>
        <field name="model">nord_sync.alert.wizard</field>
        <field name="arch" type="xml">
            <form string="Emit Alert">
                <group>
                    <field name="workcenter_id" invisible="1"/>
                    <field name="loss_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_emit" type="object" string="Emit alert" class="btn-warning"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
