<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nord_sync_workorder_start_wizard_form" model="ir.ui.view">
        <field name="name">nord_sync.workorder.start.wizard.form</field>
        <field name="model">nord_sync.workorder.start.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="workorder_id" readonly="1"/>
                    <field name="workcenter_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button name="action_change_workcenter" type="object" string="Change Work Center" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nord_sync_workorder_workcenter_change_wizard_form" model="ir.ui.view">
        <field name="name">nord_sync.workorder.workcenter.change.wizard.form</field>
        <field name="model">nord_sync.workorder.workcenter.change.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="workorder_id" readonly="1"/>
                    <field name="workcenter_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
