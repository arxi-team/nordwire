<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_nord_sync" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.nord.sync</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Nordwire" string="Nordwire" name="nord_sync"
                         groups="base.group_system">
                        <h2>Nordwire</h2>
                        <div class="row mt16 o_settings_container" name="nord_sync_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="nord_sync_enabled"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="nord_sync_enabled" string="Nordwire Enabled"/>
                                    <div class="text-muted">
                                        Queue changes selected and notify the Nord Cloud webhook.
                                    </div>
                                    <div class="content-group" invisible="not nord_sync_enabled">
                                        <div class="mt16">
                                            <label for="nord_sync_company_uid" class="me-3"/>
                                            <field name="nord_sync_company_uid"/>
                                        </div>
                                </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                                <div class="o_setting_right_pane">
                                    <div class="text-muted mb-3">
                                        Run the install wizard for environment pre-flight checks
                                        (scheduler active, Odoo version) before configuring.
                                    </div>
                                    <button name="action_open_nord_sync_install_wizard" type="object"
                                            string="Open Install Wizard" class="btn btn-outline-primary"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                                <div class="o_setting_right_pane">
                                    <label for="nord_sync_job_naming_mode" string="Job Naming"/>
                                    <div class="text-muted">
                                        How jobs created on the Nord Core from this company's synced
                                        records get their name/reference.
                                    </div>
                                    <div class="content-group">
                                        <div class="mt16">
                                            <field name="nord_sync_job_naming_mode" />
                                            <field name="nord_sync_job_naming_custom_prefix"
                                                   invisible="nord_sync_job_naming_mode != 'custom_prefix'"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" invisible="not nord_sync_enabled">
                                <div class="o_setting_right_pane">
                                    <label for="nord_sync_wake_mode" string="Wake Behavior"/>
                                    <div class="text-muted">
                                        Immediate: every change pings the Nord Cloud wake webhook right
                                        away. Throttled: at most one wake ping every Wake Throttle
                                        below, however many changes happen in between.
                                    </div>
                                    <div class="content-group">
                                        <div class="mt16">
                                            <field name="nord_sync_wake_mode" />
                                            <field name="nord_sync_wake_throttle_minutes"
                                                   invisible="nord_sync_wake_mode != 'throttled'" class="me-3"/>
                                            <span invisible="nord_sync_wake_mode != 'throttled'">minutes</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Job Stages, Job Stage Mapping, Payload Fields, and
                             Automation Rules live under Nordwire > Settings
                             (real submenus, each with its own access group)
                             instead of link-out buttons here. -->
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_nord_sync_res_config_settings" model="ir.actions.act_window">
            <field name="name">Nordwire Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_id" ref="res_config_settings_view_form_nord_sync"/>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module': 'nord_sync'}</field>
        </record>

        <!-- First entry under Nordwire > Configuration — same
             base.group_system gate as the res.config.settings <app> block
             it opens, so nothing here grants access the button-based
             version didn't already have. -->
        <menuitem id="menu_nord_sync_general_settings" name="Settings"
                  parent="nord_sync.menu_nord_sync_settings" action="action_nord_sync_res_config_settings"
                  groups="base.group_system" sequence="5"/>

    </data>
</odoo>
