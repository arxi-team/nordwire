<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="ir_actions_server_view_form_inherit_nord_sync" model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.inherit.nord_sync</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='action_content']" position="inside">
                <group invisible="state != 'nord_sync_notify'">
                    <field name="nord_sync_operation" required="state == 'nord_sync_notify'"/>
                </group>
            </xpath>
        </field>
    </record>

</data></odoo>
