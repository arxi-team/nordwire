<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_nord_sync_inbox_list" model="ir.ui.view">
            <field name="name">nord_sync.inbox.list</field>
            <field name="model">nord_sync.inbox</field>
            <field name="arch" type="xml">
                <tree create="0" edit="0" delete="0">
                    <field name="id" string="Seq"/>
                    <field name="company_id"/>
                    <field name="endpoint"/>
                    <field name="res_model" string="Model"/>
                    <field name="status" decoration-danger="status == 'failed'"
                           decoration-muted="status == 'pending'"/>
                    <field name="last_error" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="view_nord_sync_inbox_form" model="ir.ui.view">
            <field name="name">nord_sync.inbox.form</field>
            <field name="model">nord_sync.inbox</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="company_id"/>
                            <field name="endpoint"/>
                            <field name="res_model" string="Model"/>
                            <field name="status"/>
                            <field name="last_error"/>
                        </group>
                        <notebook>
                            <page string="Payload">
                                <field name="payload"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_nord_sync_inbox_search" model="ir.ui.view">
            <field name="name">nord_sync.inbox.search</field>
            <field name="model">nord_sync.inbox</field>
            <field name="arch" type="xml">
                <search>
                    <field name="res_model" string="Model"/>
                    <field name="endpoint"/>
                    <field name="company_id"/>
                    <filter string="Stuck (&gt;1h)" name="filter_stuck_1h"
                            domain="[('create_date', '&lt;', (datetime.datetime.now() - datetime.timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S'))]"
                            help="Still here more than an hour after arriving — the cron should have picked it up long before this."/>
                    <group>
                        <filter string="Endpoint" name="group_by_endpoint" context="{'group_by': 'endpoint'}"/>
                        <filter string="Model" name="group_by_model" context="{'group_by': 'res_model'}"/>
                        <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                        <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_nord_sync_inbox" model="ir.actions.act_window">
            <field name="name">Sync Inbox</field>
            <field name="res_model">nord_sync.inbox</field>
            <field name="view_mode">tree,form</field>
            <!-- Explicit empty domain, not omitted — see action_nord_sync_queue's
                 own comment for why (an omitted field is never cleared on
                 module update). -->
            <field name="domain">[]</field>
        </record>

        <menuitem id="menu_nord_sync_inbox" name="Sync Inbox"
                  parent="menu_nord_sync_group" action="action_nord_sync_inbox"
                  groups="group_nord_sync_user" sequence="30"/>

    </data>
</odoo>
