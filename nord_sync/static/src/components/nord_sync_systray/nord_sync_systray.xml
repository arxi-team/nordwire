<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nord_sync.NordSyncSystray">
        <div class="o_nord_sync_systray d-flex align-items-center px-2"
             t-if="state.failedCount"
             t-on-click="onClick"
             role="button"
             style="cursor: pointer;"
             title="Nordwire: failed synchronizations">
            <i class="fa fa-exclamation-triangle text-danger" role="img" aria-label="Nordwire failures"/>
            <span class="badge text-bg-danger ms-1" t-esc="state.failedCount"/>
        </div>
    </t>
</templates>
