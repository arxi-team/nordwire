<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nord_sync_setup_wizard_view_form" model="ir.ui.view">
        <field name="name">nord.sync.setup.wizard.form</field>
        <field name="model">nord.sync.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Nord Sync Setup">
                <field name="state" invisible="1"/>

                <group invisible="state != 'preflight'">
                    <div class="alert alert-warning" role="alert" invisible="not preflight_warning">
                        <field name="preflight_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="preflight_warning">
                        All pre-flight checks passed.
                    </div>
                    <group string="Pre-flight checks">
                        <field name="odoo_version_supported"/>
                    </group>
                </group>

                <group invisible="state != 'config'">
                    <field name="company_uid"/>
                    <field name="cloud_webhook_url"/>
                    <field name="mo_filter_criteria"/>
                </group>

                <footer>
                    <button name="action_next" string="Next" type="object"
                            class="btn-primary" invisible="state != 'preflight'"/>
                    <button name="action_back" string="Back" type="object"
                            invisible="state != 'config'"/>
                    <button name="action_save_config" string="Save" type="object"
                            class="btn-primary" invisible="state != 'config'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="nord_sync_setup_wizard_action" model="ir.actions.act_window">
        <field name="name">Nord Sync Setup Wizard</field>
        <field name="res_model">nord.sync.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
