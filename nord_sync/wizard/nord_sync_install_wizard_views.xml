<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_nord_sync_install_wizard_form" model="ir.ui.view">
            <field name="name">nord_sync.install.wizard.form</field>
            <field name="model">nord_sync.install.wizard</field>
            <field name="arch" type="xml">
                <form string="Nordwire — Install">
                    <field name="state" invisible="1"/>
                    <field name="preflight_ok" invisible="1"/>
                    <field name="show_previous" invisible="1"/>
                    <field name="show_next" invisible="1"/>
                    <field name="show_finish" invisible="1"/>

                    <div invisible="state != 'step_preflight'">
                        <h3>Step 1. Environment Pre-flight</h3>
                        <div class="alert alert-warning" role="alert" invisible="preflight_ok">
                            <field name="preflight_message" readonly="1" nolabel="1"/>
                        </div>
                        <div class="alert alert-success" role="alert" invisible="not preflight_ok">
                            <field name="preflight_message" readonly="1" nolabel="1"/>
                        </div>
                        <group>
                            <field name="cron_active"/>
                            <field name="odoo_version_supported"/>
                        </group>
                        <button name="action_refresh_preflight" type="object"
                                string="Refresh Preflight Check" invisible="preflight_ok"/>
                    </div>

                    <div invisible="state != 'step_sources'">
                        <h3>Step 2. What do you want to sync?</h3>
                        <p class="text-muted">
                            Pick the parts of your business that should produce jobs on
                            the Nord Core. Everything is checked by default.
                        </p>
                        <field name="source_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </div>

                    <div invisible="state != 'step_connection'">
                        <h3>Step 3. Connection</h3>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="company_uid"/>
                            <field name="cloud_base_url"/>
                        </group>
                    </div>

                    <div invisible="state != 'step_job_stages'">
                        <h3>Step 4. Job Stages</h3>
                        <group>
                            <field name="job_stage_mode" widget="radio"/>
                        </group>
                        <field name="job_stage_line_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                            </tree>
                        </field>
                        <p class="text-muted">
                            Optional — leave empty for no stage granularity (a job's
                            state alone still works).
                        </p>
                    </div>

                    <div invisible="state != 'step_mapping'">
                        <h3>Step 5. Mapping</h3>
                        <p class="text-muted">
                            For each native state value (Manufacturing Orders, and every
                            other source Nordwire bridges), choose which Job Stage its
                            job lands in on the Nord Core, or leave it blank to not map
                            that value at all. You decide which values matter; nothing
                            here is forced.
                        </p>
                        <field name="mapping_line_ids">
                            <!-- create/delete disabled deliberately: one row per native
                                 value per installed source IS the row set (see the line
                                 model's own docstring) — a manually added row could never
                                 have a valid source_value (readonly, no default), only
                                 ever error. Rows are grouped by source via `sequence`
                                 (assigned block-by-block in _mapping_line_vals), told
                                 apart by the Source column since a Transient wizard list
                                 can't render one sub-section per source. -->
                            <tree editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="1"/>
                                <field name="wizard_id" column_invisible="1"/>
                                <field name="source_model" column_invisible="1"/>
                                <field name="source_value" column_invisible="1"/>
                                <field name="source_label" readonly="1" string="Source"/>
                                <field name="source_value_label" readonly="1" string="Source Value"/>
                                <field name="target_job_stage_line_id" string="Job Stage"/>
                            </tree>
                        </field>
                    </div>

                    <div invisible="state != 'step_job_naming'">
                        <h3>Step 6. Job Naming</h3>
                        <p class="text-muted">
                            How should jobs created on the Nord Core from your synced
                            records be named?
                        </p>
                        <group>
                            <field name="job_naming_mode" widget="radio"/>
                            <field name="job_naming_custom_prefix"
                                   invisible="job_naming_mode != 'custom_prefix'"
                                   placeholder="ACME-JOB/2026/"/>
                        </group>
                    </div>

                    <div invisible="state != 'step_finish'">
                        <h3>Step 7. Confirm</h3>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="company_uid" readonly="1"/>
                            <field name="cloud_base_url" readonly="1"/>
                        </group>
                        <p>Confirming activates Nordwire for this company.</p>
                    </div>

                    <footer>
                        <button name="action_previous_step" type="object"
                                string="Previous" invisible="not show_previous"/>
                        <button name="action_confirm_sources" type="object" string="Next"
                                class="btn-primary"
                                invisible="not show_next or state != 'step_sources'"/>
                        <button name="action_next_step" type="object" string="Next"
                                class="btn-primary"
                                invisible="not show_next or state == 'step_sources'"/>
                        <button name="action_confirm" type="object" string="Confirm"
                                class="btn-primary" invisible="not show_finish"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_nord_sync_install_wizard" model="ir.actions.act_window">
            <field name="name">Nordwire — Install</field>
            <field name="res_model">nord_sync.install.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>

    <!-- Shown automatically right after installing the module (Odoo's own
         "next step" mechanism, ir.module.module.next()) — noupdate so it
         doesn't reappear on every module upgrade, only on first install. -->
    <data noupdate="1">
        <record id="config_wizard_nord_sync_install" model="ir.actions.todo">
            <field name="action_id" ref="action_nord_sync_install_wizard"/>
            <field name="sequence">10</field>
            <field name="state">open</field>
        </record>
    </data>
</odoo>
