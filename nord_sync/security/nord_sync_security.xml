<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_nord_sync_integration" model="res.groups">
            <field name="name">Nordwire Integration</field>
            <field name="comment">Technical users authenticating as the Nord Core (API key, scope=rpc) belong here.</field>
        </record>

        <!-- Manager is deliberately not the Odoo administrator — the Nord
             Cloud URL (system parameter) and non-Nordwire Automation Rules
             stay reserved to base.group_system on purpose. -->
        <record id="group_nord_sync_user" model="res.groups">
            <field name="name">Nordwire User</field>
            <field name="comment">Read-only: Sync Queue, Sync Failures, and manual retry of failed webhooks.</field>
        </record>
        <record id="group_nord_sync_manager" model="res.groups">
            <field name="name">Nordwire Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_nord_sync_user'))]"/>
            <field name="comment">Nordwire User, plus Configuration (enabled/company UID per company), the
                Install Wizard, and the nord_sync-tagged Automation Rules (never other modules').</field>
        </record>

        <!-- base.automation and ir.actions.server are generic Odoo models, natively
             restricted to base.group_system with no exceptions — granting Manager
             the model access below without this rule would let them edit
             Automation Rules belonging to any module, not just nord_sync's. Same
             ('name', 'like', 'Nordwire') filter already used by
             action_nord_sync_automation_rules (data/nord_sync_automation.xml). -->
        <record id="rule_base_automation_nord_sync_manager" model="ir.rule">
            <field name="name">Nordwire Manager: only Nordwire automation rules</field>
            <field name="model_id" ref="base_automation.model_base_automation"/>
            <field name="groups" eval="[(4, ref('group_nord_sync_manager'))]"/>
            <field name="domain_force">[('name', 'like', 'Nordwire')]</field>
        </record>
        <!-- The base_automation.ir_cron_data_base_automation_check_ir_actions_server
             OR-clause below exists because ir.cron uses _inherits =
             {'ir.actions.server': 'ir_actions_server_id'} (odoo/addons/base/models/
             ir_cron.py) — Odoo propagates a parent model's ir.rule onto the
             delegating child model AS AN ADDITIONAL AND-ed CONSTRAINT (delegate
             access = access to the child's own rules AND access to the parent
             record), not as an alternative a same-group ir.cron-only rule could
             OR against. base_automation's own write()/create()/unlink() hooks
             (_update_cron(), base_automation/models/base_automation.py) read AND
             write the shared base_automation.ir_cron_data_base_automation_check
             cron record — and therefore its delegate ir.actions.server record too —
             on every save of ANY base.automation record, including the Nordwire
             ones themselves. Without this exception, that silently broke editing
             Nordwire's own automation rules for anyone in Nordwire Manager
             (AccessError on ir.cron, record rules). Named by its own stable xmlid
             (not the ir.cron's — a _inherits delegate record gets its own separate
             one), scoped to that one shared system object specifically — Manager
             still can't browse/edit arbitrary Scheduled Actions or other unrelated
             Server Actions, matching Manager's narrower-than-administrator scope. -->
        <record id="rule_ir_actions_server_nord_sync_manager" model="ir.rule">
            <field name="name">Nordwire Manager: only Nordwire automation actions</field>
            <field name="model_id" ref="base.model_ir_actions_server"/>
            <field name="groups" eval="[(4, ref('group_nord_sync_manager'))]"/>
            <field name="domain_force" eval="['|', ('name', 'like', 'Nordwire'), ('id', '=', ref('base_automation.ir_cron_data_base_automation_check_ir_actions_server'))]"/>
        </record>

        <!-- Real bug, found 2026-08-18: none of this addon's 4 own
             company-owned models had a multi-company ir.rule at all — Odoo
             never generates one automatically just from a company_id field
             existing, each addon has to ship its own (see resource/nordos_core
             for the same pattern already used elsewhere in this codebase).
             Without this, a user in company A could read every other
             company's sync queue/config/job stages/state mappings just by
             having the model access group, regardless of which company was
             selected in the switcher. No groups field — applies to every
             group with read access to these models (User, Manager,
             Integration alike), never just a subset. company_id is
             required=True on all 4 models, so no '+ [False]' fallback
             needed (nothing here is ever company-less). -->
        <record id="rule_nord_sync_config_multi_company" model="ir.rule">
            <field name="name">nord_sync.config: multi-company</field>
            <field name="model_id" ref="model_nord_sync_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_nord_sync_job_stage_multi_company" model="ir.rule">
            <field name="name">nord_sync.job.stage: multi-company</field>
            <field name="model_id" ref="model_nord_sync_job_stage"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_nord_sync_state_mapping_multi_company" model="ir.rule">
            <field name="name">nord_sync.state.mapping: multi-company</field>
            <field name="model_id" ref="model_nord_sync_state_mapping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_nord_sync_queue_multi_company" model="ir.rule">
            <field name="name">nord.sync.queue: multi-company</field>
            <field name="model_id" ref="model_nord_sync_queue"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_nord_sync_queue_line_multi_company" model="ir.rule">
            <field name="name">nord.sync.queue.line: multi-company</field>
            <field name="model_id" ref="model_nord_sync_queue_line"/>
            <field name="domain_force">[('queue_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
