<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Job Stages ─────────────────────────────────────────────────── -->

        <record id="view_nord_sync_job_stage_list" model="ir.ui.view">
            <field name="name">nord_sync.job.stage.list</field>
            <field name="model">nord_sync.job.stage</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="action_nord_sync_job_stage" model="ir.actions.act_window">
            <field name="name">Job Stages</field>
            <field name="res_model">nord_sync.job.stage</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define the job stages this company uses.
                </p>
                <p>
                    Pushed to the Nord Core automatically — reference them from
                    a Job Stage Mapping row below to control which stage a job
                    lands in.
                </p>
            </field>
        </record>

        <menuitem id="menu_nord_sync_job_stage" name="Job Stages"
                  parent="menu_nord_sync_root" action="action_nord_sync_job_stage"
                  groups="group_nord_sync_manager" sequence="30"/>

        <!-- ── State Mapping ──────────────────────────────────────────────── -->

        <record id="view_nord_sync_state_mapping_list" model="ir.ui.view">
            <field name="name">nord_sync.state.mapping.list</field>
            <field name="model">nord_sync.state.mapping</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="source_model"/>
                    <field name="source_value"/>
                    <field name="target_job_stage_id"/>
                </list>
            </field>
        </record>

        <record id="action_nord_sync_state_mapping" model="ir.actions.act_window">
            <field name="name">Job Stage Mapping</field>
            <field name="res_model">nord_sync.state.mapping</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No mapping configured yet.
                </p>
                <p>
                    Each row says which job stage a source value (e.g. a
                    Manufacturing Order state) should set on the matching job
                    on the Nord Core. Job state itself is never configured
                    anywhere on this client — it's exclusive to the job,
                    resolved entirely on the Nord Core. A value with no
                    matching row here just leaves its job stage alone.
                </p>
            </field>
        </record>

        <menuitem id="menu_nord_sync_state_mapping" name="Job Stage Mapping"
                  parent="menu_nord_sync_root" action="action_nord_sync_state_mapping"
                  groups="group_nord_sync_manager" sequence="40"/>

    </data>
</odoo>
