<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Dedicated view, distinct from the generic Sync Queue (which
             shows every entry regardless of status) — built on the same
             nord.sync.queue table (a failure log doesn't need its own
             model), just filtered to status='failed'. -->
        <record id="view_nord_sync_failures_list" model="ir.ui.view">
            <field name="name">nord.sync.queue.failures.list</field>
            <field name="model">nord.sync.queue</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="id" string="Seq"/>
                    <field name="company_id"/>
                    <field name="res_model"/>
                    <field name="res_id"/>
                    <field name="operation"/>
                    <field name="last_error"/>
                </list>
            </field>
        </record>

        <!-- Form is new — this list had none before (create/edit/delete all
             blocked). Read-only, just the same fields as the list plus a
             button into the shared Failure Wizard (create an activity for
             whoever, or jump to the related record) — the technical
             audience's route to it for any res_model, including the ones
             _nord_sync_visible_owner hides from the systray/MO surfaces. -->
        <record id="view_nord_sync_failures_form" model="ir.ui.view">
            <field name="name">nord.sync.queue.failures.form</field>
            <field name="model">nord.sync.queue</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <header>
                        <button name="action_open_failure_wizard" type="object"
                                string="Take Action" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="company_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="operation"/>
                            <field name="last_error"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_nord_sync_failures" model="ir.actions.act_window">
            <field name="name">Nord Sync: Sync Failures</field>
            <field name="res_model">nord.sync.queue</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('status', '=', 'failed')]</field>
        </record>

        <record id="action_nord_sync_failures_view_list" model="ir.actions.act_window.view">
            <field name="sequence">1</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_nord_sync_failures_list"/>
            <field name="act_window_id" ref="action_nord_sync_failures"/>
        </record>
        <record id="action_nord_sync_failures_view_form" model="ir.actions.act_window.view">
            <field name="sequence">2</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_nord_sync_failures_form"/>
            <field name="act_window_id" ref="action_nord_sync_failures"/>
        </record>

        <menuitem id="menu_nord_sync_failures" name="Sync Failures"
                  parent="menu_nord_sync_root" action="action_nord_sync_failures"
                  groups="group_nord_sync_user" sequence="20"/>

        <!-- Manual resend — appears in the list view's Action (⚙)
             menu once one or more rows are selected. -->
        <record id="action_server_retry_now" model="ir.actions.server">
            <field name="name">Nord Sync: Retry Now</field>
            <field name="model_id" ref="model_nord_sync_queue"/>
            <field name="binding_model_id" ref="model_nord_sync_queue"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_retry_now()</field>
        </record>

    </data>
</odoo>
