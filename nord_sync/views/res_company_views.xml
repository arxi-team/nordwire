<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_company_form_inherit_nord_sync" model="ir.ui.view">
            <field name="name">res.company.form.nord.sync</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Nord Sync" name="nord_sync">
                        <group>
                            <field name="nord_sync_enabled"/>
                            <field name="nord_sync_company_uid" invisible="not nord_sync_enabled"/>
                            <field name="nord_sync_cloud_webhook_url" invisible="not nord_sync_enabled"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>
