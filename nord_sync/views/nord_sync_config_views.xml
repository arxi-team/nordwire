<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_nord_sync_config_list" model="ir.ui.view">
            <field name="name">nord_sync.config.list</field>
            <field name="model">nord_sync.config</field>
            <field name="arch" type="xml">
                <list create="0">
                    <field name="company_id"/>
                    <field name="enabled"/>
                    <field name="company_uid"/>
                    <field name="cloud_webhook_url"/>
                </list>
            </field>
        </record>

        <record id="view_nord_sync_config_form" model="ir.ui.view">
            <field name="name">nord_sync.config.form</field>
            <field name="model">nord_sync.config</field>
            <field name="arch" type="xml">
                <form create="0">
                    <sheet>
                        <group>
                            <field name="company_id"/>
                            <field name="enabled"/>
                            <field name="company_uid"/>
                            <field name="cloud_webhook_url"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_nord_sync_config" model="ir.actions.act_window">
            <field name="name">Nord Sync Configuration</field>
            <field name="res_model">nord_sync.config</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
