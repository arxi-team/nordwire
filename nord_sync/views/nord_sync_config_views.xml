<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_nord_sync_config_list" model="ir.ui.view">
            <field name="name">nord_sync.config.list</field>
            <field name="model">nord_sync.config</field>
            <field name="arch" type="xml">
                <list create="0">
                    <field name="company_id"/>
                    <field name="enabled"/>
                    <field name="company_uid"/>
                </list>
            </field>
        </record>

        <record id="view_nord_sync_config_form" model="ir.ui.view">
            <field name="name">nord_sync.config.form</field>
            <field name="model">nord_sync.config</field>
            <field name="arch" type="xml">
                <form create="0">
                    <header>
                        <button name="%(action_nord_sync_install_wizard)d" type="action"
                                string="Open Install Wizard" class="btn-primary"
                                context="{'default_company_id': company_id}"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="company_id"/>
                            <field name="enabled"/>
                            <field name="company_uid"/>
                            <field name="job_naming_mode"/>
                            <field name="job_naming_custom_prefix"
                                   invisible="job_naming_mode != 'custom_prefix'"/>
                            <field name="mirror_mode"/>
                            <field name="wake_mode"/>
                            <field name="wake_throttle_minutes" invisible="wake_mode != 'throttled'"/>
                            <field name="last_wake_sent" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_nord_sync_config" model="ir.actions.act_window">
            <field name="name">Configuration</field>
            <field name="res_model">nord_sync.config</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_nord_sync_config" name="Configuration"
                  parent="menu_nord_sync_root" action="action_nord_sync_config"
                  groups="group_nord_sync_manager" sequence="30"/>

    </data>
</odoo>
