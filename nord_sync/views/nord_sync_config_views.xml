<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nord_sync_config_view_list" model="ir.ui.view">
        <field name="name">nord.sync.config.list</field>
        <field name="model">nord.sync.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="company_uid"/>
                <field name="cloud_webhook_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="nord_sync_config_view_form" model="ir.ui.view">
        <field name="name">nord.sync.config.form</field>
        <field name="model">nord.sync.config</field>
        <field name="arch" type="xml">
            <form string="Nord Sync Configuration">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="company_uid"/>
                        <field name="cloud_webhook_url"/>
                        <field name="mo_filter_criteria"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nord_sync_config_action" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">nord.sync.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
