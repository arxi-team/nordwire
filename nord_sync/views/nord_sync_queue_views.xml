<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_nord_sync_queue_list" model="ir.ui.view">
            <field name="name">nord.sync.queue.list</field>
            <field name="model">nord.sync.queue</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="id" string="Seq"/>
                    <field name="company_id"/>
                    <field name="owner_res_model" string="Model"/>
                    <field name="owner_res_id" string="Record ID"/>
                    <field name="is_sealed" widget="boolean_toggle"/>
                    <field name="status" decoration-danger="status == 'failed'"
                           decoration-muted="status == 'pending'"/>
                    <field name="last_error" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_nord_sync_queue_form" model="ir.ui.view">
            <field name="name">nord.sync.queue.form</field>
            <field name="model">nord.sync.queue</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="company_id"/>
                            <field name="owner_res_model" string="Model"/>
                            <field name="owner_res_id" string="Record ID"/>
                            <field name="status"/>
                            <field name="last_error"/>
                            <field name="is_sealed"/>
                        </group>
                        <notebook>
                            <page string="Payload">
                                <field name="payload"/>
                            </page>
                            <page string="Changes">
                                <field name="line_ids">
                                    <list create="0" edit="0" delete="0">
                                        <field name="id" string="Seq"/>
                                        <field name="res_model"/>
                                        <field name="res_id"/>
                                        <field name="operation"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_nord_sync_queue" model="ir.actions.act_window">
            <field name="name">Nordwire Queue</field>
            <field name="res_model">nord.sync.queue</field>
            <field name="view_mode">list,form</field>
            <!-- Explicit empty domain, not omitted — an omitted field is
                 never cleared on module update (Odoo's XML loader only
                 writes fields actually listed), so a DB that went through
                 an earlier revision of this action with a real domain here
                 would keep that stale domain forever otherwise. -->
            <field name="domain">[]</field>
        </record>

        <!-- Root app menu — no parent, so it shows as its own
             top-level entry/App tile instead of nesting under Settings. Group is
             Nordwire User only: Manager sees it too via implied_ids, so listing
             both here would be redundant. -->
        <menuitem id="menu_nord_sync_root" name="Nordwire"
                  web_icon="nord_sync,static/description/icon.png"
                  groups="group_nord_sync_user" sequence="120"/>

        <!-- Sync Queue has no menu item of its own — it's opened from a
             button on the Sync Overview page (action_nord_sync_queue is
             kept for that, just not menu-bound anymore). -->

        <!-- Parent for the config screens (Job Stages, Job Stage Mapping,
             Payload Fields, Automation Rules) — each keeps its own group
             on its menuitem (they don't all share the same access), this
             is just the folder they live in. -->
        <menuitem id="menu_nord_sync_settings" name="Settings"
                  parent="menu_nord_sync_root" sequence="40"/>

    </data>
</odoo>
