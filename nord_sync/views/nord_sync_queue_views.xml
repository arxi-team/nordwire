<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_nord_sync_queue_list" model="ir.ui.view">
            <field name="name">nord.sync.queue.list</field>
            <field name="model">nord.sync.queue</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="id" string="Seq"/>
                    <field name="company_id"/>
                    <field name="res_model"/>
                    <field name="res_id"/>
                    <field name="operation"/>
                    <field name="status" decoration-danger="status == 'failed'"
                           decoration-muted="status == 'pending'"/>
                    <field name="last_error" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="action_nord_sync_queue" model="ir.actions.act_window">
            <field name="name">Nord Sync Queue</field>
            <field name="res_model">nord.sync.queue</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="menu_nord_sync_root" name="Nord Sync"
                  parent="base.menu_custom" groups="base.group_system" sequence="118"/>

        <menuitem id="menu_nord_sync_queue" name="Nord Sync Queue"
                  parent="menu_nord_sync_root" action="action_nord_sync_queue"
                  groups="base.group_system" sequence="120"/>

    </data>
</odoo>
