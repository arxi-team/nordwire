<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo -> Cloud leg (plano canónico §4.1): native "Send Webhook
        Notification" server action, wired to an Automation Rule that fires
        on every nord.sync.queue row creation. No custom Python POST/retry -
        the Cloud only validates company_uid. webhook_url starts blank and is
        set by the setup wizard (action_save_config); rows with no active
        config leave company_uid blank, which the rule's filter_domain uses
        to skip firing without dropping the audit trail.
    -->
    <record id="webhook_action_queue_to_cloud" model="ir.actions.server">
        <field name="name">Nord Sync: send queue entry to Cloud</field>
        <field name="model_id" ref="model_nord_sync_queue"/>
        <field name="state">webhook</field>
        <field name="usage">base_automation</field>
        <field name="webhook_field_ids" eval="[(6, 0, [
            ref('field_nord_sync_queue__company_uid'),
            ref('field_nord_sync_queue__model_name'),
            ref('field_nord_sync_queue__operation'),
            ref('field_nord_sync_queue__res_id'),
            ref('field_nord_sync_queue__payload'),
        ])]"/>
    </record>

    <record id="automation_queue_to_cloud" model="base.automation">
        <field name="name">Nord Sync: Odoo -&gt; Cloud webhook</field>
        <field name="model_id" ref="model_nord_sync_queue"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain">[('company_uid', '!=', False)]</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('webhook_action_queue_to_cloud')])]"/>
    </record>
</odoo>
