<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Per-source Automation Rules (mrp.production, maintenance.request, ...)
         live in their own Nordwire Source addons — this base module only
         keeps the generic navigation into whichever rules whatever's
         installed actually shipped, filtered by name. -->

    <record id="action_nord_sync_automation_rules" model="ir.actions.act_window">
        <field name="name">Nordwire: Automation Rules</field>
        <field name="res_model">base.automation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|', ('name', 'like', 'Nordwire'), ('name', 'like', 'Nord Sync')]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_nord_sync_automation_rules" name="Automation Rules"
              parent="nord_sync.menu_nord_sync_settings" action="action_nord_sync_automation_rules"
              groups="group_nord_sync_manager" sequence="40"/>

</odoo>
