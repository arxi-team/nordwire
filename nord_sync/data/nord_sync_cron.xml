<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Complements the Core's own periodic reconciliation
             (_incremental_sync) with one on the trigger side — a webhook that
             failed to reach the Cloud (network blip, Cloud briefly down) gets
             retried here instead of only ever being picked up by the Core's
             next scheduled pull. -->
        <record id="ir_cron_retry_failed_webhooks" model="ir.cron">
            <field name="name">Nord Sync: Retry Failed Webhooks</field>
            <field name="model_id" ref="model_nord_sync_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed_webhooks()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Garbage-collects nord.sync.queue rows the Core has confirmed
             (core_applied_seq) it applied — never by age, see
             _cleanup_synced_queue_entries. Daily is plenty; this is
             disk-hygiene, not anything time-sensitive. -->
        <record id="ir_cron_cleanup_synced_queue_entries" model="ir.cron">
            <field name="name">Nord Sync: Cleanup Confirmed Queue Entries</field>
            <field name="model_id" ref="model_nord_sync_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_synced_queue_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Wake Mode Throttled companies only — separate cadence from the
             retry cron above (5 min, a different concern) so a small
             wake_throttle_minutes is actually honored, not rounded up. -->
        <record id="ir_cron_send_throttled_wakes" model="ir.cron">
            <field name="name">Nord Sync: Send Throttled Wakes</field>
            <field name="model_id" ref="model_nord_sync_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_throttled_wakes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
