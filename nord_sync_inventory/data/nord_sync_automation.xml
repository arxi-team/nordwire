<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" so a module upgrade doesn't overwrite whatever the client
         has since changed here, same as every other Nord Sync Source addon. -->
    <data noupdate="1">

        <record id="automation_stock_picking_created" model="base.automation">
            <field name="name">Nord Sync: Transfer created</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="trigger">on_create</field>
        </record>
        <record id="automation_stock_picking_created_action" model="ir.actions.server">
            <field name="name">Nord Sync: notify Cloud</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="base_automation_id" ref="automation_stock_picking_created"/>
            <field name="state">nord_sync_notify</field>
            <field name="nord_sync_operation">create</field>
        </record>

    </data>
</odoo>
