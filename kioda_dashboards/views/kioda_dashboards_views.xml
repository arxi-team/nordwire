<odoo>
    <!-- Vista List -->
    <record id="view_kioda_dashboards_list" model="ir.ui.view">
        <field name="name">kioda.dashboards.list</field>
        <field name="model">kioda.dashboards</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="screen"/>
                <field name="uuid"/>
                <button name="action_open_devices" type="object" string="Ver dispositivos" class="btn-primary"/>
                <button name="action_open_device_url" type="object" string="Open" class="btn-secondary"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_kioda_dashboards_form" model="ir.ui.view">
        <field name="name">kioda.dashboards.form</field>
        <field name="model">kioda.dashboards</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="screen"/>
                        <field name="uuid" readonly="1"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kioda_dashboards_devices_view_list" model="ir.ui.view">
        <field name="name">kioda.dashboards.devices.list</field>
        <field name="model">kioda.dashboards.devices</field>
        <field name="arch" type="xml">
            <list string="Dispositivos" editable="bottom" create="false">
                <field name="name"/>
                <field name="mac"/>
                <field name="token" readonly="1"/>
                <field name="has_access" readonly="1" column_invisible="1"/>
                <button name="action_add_access" type="object" string="Dar Acesso" class="btn-primary" invisible="has_access"/>
                <button name="action_remove_access" type="object" string="Revogar Acesso" class="btn-secondary" invisible="not has_access"/>
                <button name="restart_token" type="object" string="Reiniciar Token" class="btn-primary"/>
                <button name="action_delete" type="object" string="Delete" class="btn-danger" confirm="Are you sure?"/>
            </list>
        </field>
    </record>

    <!-- Ação -->
    <record id="action_kioda_dashboards" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">kioda.dashboards</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu raiz "Kioda" replicado localmente, já que o módulo kioda_app
         não existe neste repositório. -->
    <menuitem id="menu_kioda_root"
              name="Kioda"
              groups="kioda_dashboards.group_kioda_dashboards_admin"
              web_icon="kioda_dashboards,static/description/icon.png"
              sequence="549"/>

    <menuitem id="menu_kioda_dashboards" name="Dashboards" parent="menu_kioda_root" action="action_kioda_dashboards" sequence="1"/>
</odoo>
