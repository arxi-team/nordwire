<odoo>
    <record id="kioda_dashboards_devices_view_list_flow" model="ir.ui.view">
        <field name="name">kioda.dashboards.devices.list.flow</field>
        <field name="model">kioda.dashboards.devices</field>
        <field name="inherit_id" ref="kioda_dashboards.kioda_dashboards_devices_view_list"/>
        <field name="arch" type="xml">
            <button name="restart_token" position="after">
                <button name="action_open_url" type="object" string="Abrir Flow" class="btn-secondary" invisible="not has_access"/>
            </button>
        </field>
    </record>
</odoo>
